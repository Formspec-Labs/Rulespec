# Rulespec US regulatory identifier normalization shapes
# Spec anchor: spec/rkaf-core.md §4.1
# Profile: SHACL Core, Pattern C only

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rkaf: <https://rulespec.org/ns/v1#> .

# Artifact and Proceeding reuse the identifier predicates. Each declared US
# scheme must have at least one canonical URN. Other identifiers, such as an
# eCFR or federalregister.gov URL, may coexist on the same node.
rkaf:USRegulatoryIdentifierShape a sh:NodeShape ;
  sh:targetSubjectsOf rkaf:artifactIdentifierScheme ;

  sh:or (
    [ sh:not [ sh:property [ sh:path rkaf:artifactIdentifierScheme ;
        sh:hasValue rkaf:us-cfr ] ] ]
    [ sh:property [ sh:path rkaf:hasArtifactIdentifier ;
        sh:qualifiedValueShape [
          sh:pattern "^urn:rkaf:us:cfr:[1-9][0-9]*:[0-9]+(\\.[0-9]+)?$"
        ] ;
        sh:qualifiedMinCount 1 ] ]
  ) ;
  sh:message "us-cfr requires urn:rkaf:us:cfr:<title>:<part>[.<section>] with numeric components." ;

  sh:or (
    [ sh:not [ sh:property [ sh:path rkaf:artifactIdentifierScheme ;
        sh:hasValue rkaf:us-usc ] ] ]
    [ sh:property [ sh:path rkaf:hasArtifactIdentifier ;
        sh:qualifiedValueShape [
          sh:pattern "^urn:rkaf:us:usc:[1-9][0-9]*:[1-9][0-9]*[a-z]*(-[0-9a-z]+)*$"
        ] ;
        sh:qualifiedMinCount 1 ] ]
  ) ;
  sh:message "us-usc requires urn:rkaf:us:usc:<title>:<section>; omit subsections and lowercase suffix letters." ;

  sh:or (
    [ sh:not [ sh:property [ sh:path rkaf:artifactIdentifierScheme ;
        sh:hasValue rkaf:us-rin ] ] ]
    [ sh:property [ sh:path rkaf:hasArtifactIdentifier ;
        sh:qualifiedValueShape [
          sh:pattern "^urn:rkaf:us:rin:[0-9]{4}-[A-Z]{2}[0-9]{2}$"
        ] ;
        sh:qualifiedMinCount 1 ] ]
  ) ;
  sh:message "us-rin requires urn:rkaf:us:rin:<four digits>-<two uppercase letters><two digits>." ;

  sh:or (
    [ sh:not [ sh:property [ sh:path rkaf:artifactIdentifierScheme ;
        sh:hasValue rkaf:us-frdoc ] ] ]
    [ sh:property [ sh:path rkaf:hasArtifactIdentifier ;
        sh:qualifiedValueShape [
          sh:pattern "^urn:rkaf:us:frdoc:[0-9]{4}-[0-9]{5}$"
        ] ;
        sh:qualifiedMinCount 1 ] ]
  ) ;
  sh:message "us-frdoc requires urn:rkaf:us:frdoc:<four-digit year>-<five-digit sequence>." ;

  sh:or (
    [ sh:not [ sh:property [ sh:path rkaf:artifactIdentifierScheme ;
        sh:hasValue rkaf:us-regsgov ] ] ]
    [ sh:property [ sh:path rkaf:hasArtifactIdentifier ;
        sh:qualifiedValueShape [
          sh:pattern "^urn:rkaf:us:regsgov:[A-Z0-9]+(-[A-Z0-9]+)+$"
        ] ;
        sh:qualifiedMinCount 1 ] ]
  ) ;
  sh:message "us-regsgov requires the uppercase agency-issued id after urn:rkaf:us:regsgov:." ;

  sh:or (
    [ sh:not [ sh:property [ sh:path rkaf:artifactIdentifierScheme ;
        sh:hasValue rkaf:us-pl ] ] ]
    [ sh:property [ sh:path rkaf:hasArtifactIdentifier ;
        sh:qualifiedValueShape [
          sh:pattern "^urn:rkaf:us:pl:[1-9][0-9]*-[1-9][0-9]*$"
        ] ;
        sh:qualifiedMinCount 1 ] ]
  ) ;
  sh:message "us-pl requires urn:rkaf:us:pl:<congress>-<law number> without leading zeroes." ;

  sh:or (
    [ sh:not [ sh:property [ sh:path rkaf:artifactIdentifierScheme ;
        sh:hasValue rkaf:us-eo ] ] ]
    [ sh:property [ sh:path rkaf:hasArtifactIdentifier ;
        sh:qualifiedValueShape [
          sh:pattern "^urn:rkaf:us:eo:[1-9][0-9]*$"
        ] ;
        sh:qualifiedMinCount 1 ] ]
  ) ;
  sh:message "us-eo requires urn:rkaf:us:eo:<order number> without leading zeroes." .
