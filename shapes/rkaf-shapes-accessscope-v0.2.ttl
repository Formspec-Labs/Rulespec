# Rulespec Shapes v0.2 — AccessScope
# Profile: Pattern C only (no sh:if / sh:then)
# Spec anchor: spec/rkaf-core-v0.2.md §4.6

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rkaf:  <https://rulespec.org/ns/v1#> .

rkaf:AccessScopeShape a sh:NodeShape ;
  sh:targetClass rkaf:AccessScope ;
  sh:property [ sh:path rkaf:accessScopeKind ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( rkaf:public rkaf:partnerVisible rkaf:organizationVisible
            rkaf:roleRestricted rkaf:personalRestricted
            rkaf:regulatoryRestricted rkaf:embargoUntil ) ;
    sh:message "AccessScope kind MUST be from closed enum (§4.6)." ;
  ] ;
  # Pattern C: if accessScopeKind = regulatoryRestricted, regulatoryClass MUST be present
  sh:or (
    [ sh:property [ sh:path rkaf:accessScopeKind ;
        sh:not [ sh:hasValue rkaf:regulatoryRestricted ] ] ]
    [ sh:property [ sh:path rkaf:regulatoryClass ; sh:minCount 1 ;
        sh:in ( rkaf:HIPAA-PHI rkaf:GDPR-PII rkaf:FERPA rkaf:CJIS
                rkaf:classified rkaf:legally-privileged rkaf:partner-defined ) ] ]
  ) ;
  sh:message "regulatoryRestricted AccessScope MUST declare ≥1 regulatoryClass from closed enum (§4.6)." ;
  # Pattern C: if accessScopeKind = embargoUntil, rkaf:embargoUntil (dateTime) MUST be present
  sh:or (
    [ sh:property [ sh:path rkaf:accessScopeKind ;
        sh:not [ sh:hasValue rkaf:embargoUntil ] ] ]
    [ sh:property [ sh:path rkaf:embargoUntil ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ]
  ) ;
  sh:message "embargoUntil AccessScope MUST carry rkaf:embargoUntil (xsd:dateTime) (§4.6)." ;
  # Pattern C: if accessScopeKind = roleRestricted, permittedRole MUST be present
  sh:or (
    [ sh:property [ sh:path rkaf:accessScopeKind ;
        sh:not [ sh:hasValue rkaf:roleRestricted ] ] ]
    [ sh:property [ sh:path rkaf:permittedRole ; sh:minCount 1 ] ]
  ) ;
  sh:message "roleRestricted AccessScope MUST declare ≥1 permittedRole (§4.6)." .
