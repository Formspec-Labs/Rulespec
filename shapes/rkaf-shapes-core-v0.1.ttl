# PKAF Core Shapes v0.1
# Merged Shapes Batch 1 + Shapes Batch 1.1
# Profile: PKAF-SHACL-AF (requires SHACL Advanced Features)
# Bridge contract: rkaf-bridge/1.0
# Companion to: PKAF Core v0.1, ConceptRegistry v0.1.2, four conformance fixtures

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix oa:    <http://www.w3.org/ns/oa#> .
@prefix rkaf:  <https://rulespec.org/ns/v1#> .

# === Profile declaration ===

rkaf:PKAFCoreShapesV01
  a sh:NodeShape ;
  rdfs:label "PKAF Core Shapes v0.1" ;
  rdfs:comment "Requires SHACL Advanced Features. Validators supporting SHACL-Core only will not enforce conditional shapes correctly." .

# === 1. RelationshipAssertionShape (Batch 1, base) ===

rkaf:RelationshipAssertionShape
  a sh:NodeShape ;
  sh:targetClass rkaf:RelationshipAssertion ;
  rdfs:label "Relationship Assertion (base)" ;

  sh:property [
    sh:path rkaf:assertsSubject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "Every assertion must have exactly one IRI-typed subject." ;
  ] ;

  sh:property [
    sh:path rkaf:assertsPredicate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "Every assertion must have exactly one IRI-typed predicate." ;
  ] ;

  sh:property [
    sh:path rkaf:assertsObject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Every assertion must have exactly one object (IRI or literal)." ;
  ] ;

  sh:property [
    sh:path rkaf:hasTrustZone ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:Z0RawArtifact
      rkaf:Z1ParsedFragment
      rkaf:Z2ExtractedCandidateClaim
      rkaf:Z3ScoredCandidateRelationship
      rkaf:Z4AttestedAssertion
      rkaf:Z5LocallyAdopted
      rkaf:Z6CanonicalOperational
      rkaf:Z7GeneratedWorkProduct
      rkaf:Z8PublishedOutput
    ) ;
    sh:message "Trust zone must be one of Z0–Z8." ;
  ] ;

  sh:property [
    sh:path rkaf:hasSafetyLabel ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:D0Deterministic
      rkaf:S1SearchOnly
      rkaf:R2ReviewedOperational
      rkaf:A3AuthorityCritical
      rkaf:P4Published
    ) ;
    sh:message "Safety label must be one of D0, S1, R2, A3, P4." ;
  ] ;

  sh:property [
    sh:path rkaf:usageEligibility ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:notEligible
      rkaf:searchOnly
      rkaf:reviewQueueOnly
      rkaf:draftGenerationAllowed
      rkaf:localOperationalUse
      rkaf:publicationAllowed
      rkaf:officialUse
    ) ;
    sh:message "Usage eligibility must be one of the lattice values." ;
  ] ;

  sh:property [
    sh:path rkaf:assertionOrigin ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:humanAsserted
      rkaf:aiSuggested
      rkaf:aiPromoted
      rkaf:humanQualified
      rkaf:humanRevalidation
      rkaf:reviewClassified
      rkaf:importedFromSource
      rkaf:systemDerived
    ) ;
    sh:message "Assertion origin must be from the closed enum." ;
  ] ;

  sh:or (
    [ sh:property [ sh:path rkaf:hasEvidence ; sh:minCount 1 ] ]
    [ sh:property [ sh:path rkaf:noEvidenceReason ; sh:minCount 1 ; sh:datatype xsd:string ] ]
  ) ;
  sh:message "Assertion must have at least one rkaf:hasEvidence binding, or an explicit rkaf:noEvidenceReason." .

# === 2. OperationalAssertionEvidenceShape (Batch 1.1 patch 2) ===

rkaf:OperationalAssertionEvidenceShape
  a sh:NodeShape ;
  sh:targetClass rkaf:RelationshipAssertion ;
  rdfs:label "Operational Assertion Evidence (R2/A3/P4 require real evidence)" ;
  rdfs:comment "Rewritten in Batch 4 using Pattern C (sh:or + sh:not) because pyshacl 0.31.0 does not correctly evaluate sh:if/sh:then patterns with compound sh:then bodies." ;

  # If safety label is R2/A3/P4, then hasEvidence minCount 1.
  # Pattern C equivalent: (NOT precondition) OR (requirement)
  sh:or (
    # Branch 1: safety label is NOT in the operational/authority/published set
    [ sh:not [
        sh:property [
          sh:path rkaf:hasSafetyLabel ;
          sh:in ( rkaf:R2ReviewedOperational rkaf:A3AuthorityCritical rkaf:P4Published )
        ]
    ] ]
    # Branch 2: assertion has at least one hasEvidence binding
    [ sh:property [
        sh:path rkaf:hasEvidence ;
        sh:minCount 1 ;
    ] ]
  ) ;
  sh:message "R2, A3, and P4 assertions MUST have at least one rkaf:hasEvidence binding. rkaf:noEvidenceReason is NOT sufficient at these safety levels." .

# === 3. AuthorityAssertionShape (Batch 1.1 patch 3, interim broadened evidence roles) ===

rkaf:AuthorityAssertionShape
  a sh:NodeShape ;
  sh:targetClass rkaf:RelationshipAssertion ;
  rdfs:label "Authority-Critical Assertion (A3 conditional, interim)" ;
  rdfs:comment "Rewritten in Batch 4 using Pattern C (sh:or + sh:not + sh:and) for reliable pyshacl evaluation." ;

  # If safety label is A3, then authorityKind AND hasApplicability AND qualified evidence
  sh:or (
    # Branch 1: NOT A3
    [ sh:not [
        sh:property [ sh:path rkaf:hasSafetyLabel ; sh:hasValue rkaf:A3AuthorityCritical ]
    ] ]
    # Branch 2: all three A3 requirements met
    [ sh:and (
        [ sh:property [
            sh:path rkaf:authorityKind ;
            sh:minCount 1 ; sh:maxCount 1 ;
            sh:in (
              rkaf:legal rkaf:statutory rkaf:regulatory rkaf:delegated
              rkaf:organizational rkaf:contractual rkaf:localOperational rkaf:publication
            ) ;
          ]
        ]
        [ sh:property [
            sh:path rkaf:hasApplicability ;
            sh:minCount 1 ;
          ]
        ]
        [ sh:property [
            sh:path rkaf:hasEvidence ;
            sh:qualifiedValueShape [
              sh:property [
                sh:path rkaf:evidenceRole ;
                sh:in (
                  rkaf:authorityCitation
                  rkaf:officialSourceMetadata
                  rkaf:reviewedAuthorityChain
                  rkaf:formalAdoptionEvent
                  rkaf:rescissionEvidence
                  rkaf:amendmentEvidence
                  rkaf:supersessionEvidence
                  rkaf:structuralEvidence
                )
              ]
            ] ;
            sh:qualifiedMinCount 1 ;
          ]
        ]
    ) ]
  ) ;
  sh:message "A3 authority-critical assertions must declare authorityKind (from enum), hasApplicability, and at least one hasEvidence binding with an authority or lifecycle evidence role." .

# === 4. EvidenceBindingShape (Batch 1) ===

rkaf:EvidenceBindingShape
  a sh:NodeShape ;
  sh:targetClass rkaf:EvidenceBinding ;
  rdfs:label "Evidence Binding" ;

  sh:property [
    sh:path rkaf:evidenceRole ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:textualEvidence
      rkaf:structuralEvidence
      rkaf:retrievalSignal
      rkaf:authorityCitation
      rkaf:officialSourceMetadata
      rkaf:reviewedAuthorityChain
      rkaf:formalAdoptionEvent
      rkaf:mappingRationale
      rkaf:registrationEvent
      rkaf:rescissionEvidence
      rkaf:amendmentEvidence
      rkaf:supersessionEvidence
      rkaf:corroboratingEvidence
      rkaf:counterEvidence
    ) ;
    sh:message "Evidence role must be from the enumerated vocabulary." ;
  ] ;

  sh:or (
    [ sh:property [ sh:path rkaf:sourceFragment ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    [ sh:property [ sh:path rkaf:supportingQuote ; sh:minCount 1 ; sh:datatype xsd:string ] ]
    [ sh:property [ sh:path rkaf:supportingEvent ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    [ sh:property [ sh:path rkaf:basedOnClassification ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    [ sh:property [ sh:path rkaf:rationaleText ; sh:minCount 1 ; sh:datatype xsd:string ] ]
  ) ;
  sh:message "Evidence binding must reference at least one of: sourceFragment, supportingQuote, supportingEvent, basedOnClassification, or rationaleText." .

# === 5. AttestationShape (Batch 1.1 patch 4, generalized target) ===

rkaf:AttestationShape
  a sh:NodeShape ;
  sh:targetClass rkaf:Attestation ;
  rdfs:label "Attestation (generalized target)" ;

  sh:or (
    [ sh:property [ sh:path rkaf:targetAssertion        ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    [ sh:property [ sh:path rkaf:targetWorkProduct      ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    [ sh:property [ sh:path rkaf:targetPacket           ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    [ sh:property [ sh:path rkaf:targetConcept          ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    [ sh:property [ sh:path rkaf:targetMappingConflict  ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    [ sh:property [ sh:path rkaf:targetBridgeValidation ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    [ sh:property [ sh:path rkaf:targetRegistry         ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
  ) ;
  sh:message "Attestation must reference at least one target via targetAssertion, targetWorkProduct, targetPacket, targetConcept, targetMappingConflict, targetBridgeValidation, or targetRegistry." ;

  sh:property [
    sh:path rkaf:attestor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:attestorType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      rkaf:humanUser
      rkaf:AIModel
      rkaf:AIAgent
      rkaf:automatedParser
      rkaf:team
      rkaf:organization
      rkaf:community
      rkaf:formalReviewer
      rkaf:ConceptMintingAuthority
    ) ;
  ] ;

  sh:property [
    sh:path rkaf:visibility ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( rkaf:personalVisible rkaf:teamVisible rkaf:orgVisible rkaf:publicVisible ) ;
  ] ;

  sh:property [
    sh:path prov:generatedAtTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] .

# === 5a. AttestationDecisionShape (Batch 1.1 patch 5, decision with extension URIs) ===

rkaf:AttestationDecisionShape
  a sh:NodeShape ;
  sh:targetClass rkaf:Attestation ;
  sh:property [
    sh:path rkaf:decision ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:in (
          rkaf:endorse rkaf:endorseWithQualifier rkaf:object rkaf:qualify
          rkaf:correct rkaf:retract rkaf:markStale rkaf:markNotAuthoritative
          rkaf:addEvidence rkaf:requestLegalReview rkaf:requestProgramReview
          rkaf:adoptForSearch rkaf:adoptForDrafting rkaf:adoptForOperations
          rkaf:approveForPublication rkaf:rejectLocally
          rkaf:promoteCandidate rkaf:declareCanonicalMapping
        ) ]
      [ sh:nodeKind sh:IRI ; sh:pattern "^https?://" ]
    ) ;
    sh:message "Attestation decision must be from the closed v0.1 enum or a declared extension URI." ;
  ] .

# === 5b. AttestationScopeShape (Batch 1.1 patch 5, scope with extension URIs) ===

rkaf:AttestationScopeShape
  a sh:NodeShape ;
  sh:targetClass rkaf:Attestation ;
  sh:property [
    sh:path rkaf:scope ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:in (
          rkaf:personal rkaf:team rkaf:organization rkaf:community
          rkaf:public rkaf:reviewQueue rkaf:jurisdictional
        ) ]
      [ sh:nodeKind sh:IRI ; sh:pattern "^https?://" ]
    ) ;
    sh:message "Attestation scope must be from the closed v0.1 enum or a declared extension URI." ;
  ] .

# === 6. LocalAdoptionShape (Batch 1, with Batch 1.1 patch 6 adoptionScope string-or-IRI) ===

rkaf:LocalAdoptionShape
  a sh:NodeShape ;
  sh:targetClass rkaf:LocalAdoption ;
  rdfs:label "Local Adoption" ;

  sh:property [
    sh:path rkaf:organization ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:targetAssertion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:adoptionStatus ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:notApplicable rkaf:watchOnly rkaf:searchOnly rkaf:needsReview
      rkaf:adoptedForDrafting rkaf:adoptedForLocalOperations
      rkaf:approvedForPublication rkaf:rejectedLocally
    ) ;
  ] ;

  sh:property [
    sh:path rkaf:usageEligibility ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:notEligible rkaf:searchOnly rkaf:reviewQueueOnly
      rkaf:draftGenerationAllowed rkaf:localOperationalUse
      rkaf:publicationAllowed rkaf:officialUse
    ) ;
  ] ;

  sh:property [
    sh:path rkaf:adoptionAuthorityKind ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:organizational rkaf:localOperational
      rkaf:contractual rkaf:publication
    ) ;
    sh:message "LocalAdoption authority kind must be organizational, localOperational, contractual, or publication. NOT statutory/regulatory/delegated — those flow only through hasAuthority/derivesAuthorityFrom chains." ;
  ] ;

  sh:property [
    sh:path rkaf:adoptionScope ;
    sh:minCount 1 ;
    sh:or (
      [ sh:datatype xsd:string ]
      [ sh:nodeKind sh:IRI ]
    ) ;
    sh:message "adoptionScope MUST be a string or IRI." ;
  ] ;

  sh:property [
    sh:path rkaf:authorizedBy ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path prov:generatedAtTime ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] .

# === 7. AuthorityChainHopShape (Batch 1.1 patch 7, implements removed) ===

rkaf:AuthorityChainHopShape
  a sh:NodeShape ;
  sh:targetClass rkaf:AuthorityChainHop ;
  rdfs:label "Authority Chain Hop (authority predicates only)" ;

  sh:property [
    sh:path rkaf:assertion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:predicate ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( rkaf:hasAuthority rkaf:derivesAuthorityFrom ) ;
    sh:message "Authority chain hop predicates are limited to hasAuthority and derivesAuthorityFrom. The implements predicate belongs to a justification chain, not an authority chain." ;
  ] ;

  sh:property [
    sh:path rkaf:object ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:authorityKind ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:legal rkaf:statutory rkaf:regulatory rkaf:delegated
      rkaf:organizational rkaf:contractual rkaf:localOperational rkaf:publication
    ) ;
  ] .

# === 8. BridgeValidationResultShape (Batch 1.1 patch 8, remediation OR noRemediationReason) ===

rkaf:BridgeValidationResultShape
  a sh:NodeShape ;
  sh:targetClass rkaf:BridgeValidationResult ;
  rdfs:label "Bridge Validation Result (minimal, patched)" ;

  sh:property [
    sh:path rkaf:packetId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:consumer ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:bridgeContractVersion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^rkaf-bridge/[0-9]+\\.[0-9]+$" ;
  ] ;

  sh:property [
    sh:path rkaf:result ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( rkaf:accepted rkaf:acceptedWithWarnings rkaf:rejected ) ;
  ] ;

  sh:property [
    sh:path prov:generatedAtTime ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;

  # If result is rejected, must have suggestedRemediation OR noRemediationReason
  # Rewritten in Batch 4 using Pattern C for reliable pyshacl evaluation.
  sh:or (
    # Branch 1: result is NOT rejected
    [ sh:not [
        sh:property [ sh:path rkaf:result ; sh:hasValue rkaf:rejected ]
    ] ]
    # Branch 2: has suggestedRemediation
    [ sh:property [ sh:path rkaf:suggestedRemediation ; sh:minCount 1 ] ]
    # Branch 3: has noRemediationReason from enum
    [ sh:property [
        sh:path rkaf:noRemediationReason ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in (
          rkaf:restrictedEvidenceUnavailable
          rkaf:securityBlocked
          rkaf:unsupportedBridgeVersion
          rkaf:malformedPacket
          rkaf:registryAuthorityBlocked
          rkaf:noActionableRemediation
        ) ;
    ] ]
  ) ;
  sh:message "Rejected BridgeValidationResults MUST include either rkaf:suggestedRemediation OR an enumerated rkaf:noRemediationReason." .
