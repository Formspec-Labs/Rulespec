# Rulespec Shapes Batch 2 — ConceptRegistry
# Status: draft, additive to rkaf-shapes-core-v0.1.ttl
# Profile: Rulespec-SHACL-AF
# Bridge contract: rkaf-bridge/1.0
# Spec anchors: ConceptRegistry v0.1.2 sections referenced inline

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix rkaf:  <https://rulespec.org/ns/v1#> .

# === 1. RegisteredConceptShape (ConceptRegistry v0.1.2 §2.1) ===

rkaf:RegisteredConceptShape
  a sh:NodeShape ;
  sh:targetClass rkaf:RegisteredConcept ;
  rdfs:label "Registered Concept" ;

  sh:property [
    sh:path skos:prefLabel ;
    sh:minCount 1 ;
    sh:message "RegisteredConcept must have skos:prefLabel." ;
  ] ;

  sh:property [
    sh:path rkaf:managedByRegistry ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "RegisteredConcept must declare its managing ConceptRegistry." ;
  ] ;

  sh:property [
    sh:path rkaf:conceptScope ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( rkaf:public rkaf:organization rkaf:jurisdictional rkaf:program ) ;
  ] ;

  sh:property [
    sh:path rkaf:conceptStatus ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:proposed rkaf:registered rkaf:deprecated
      rkaf:replacedBy rkaf:mergedInto rkaf:splitInto
      rkaf:withdrawn rkaf:localActive
    ) ;
    sh:message "Concept status must be from the v0.1 enum." ;
  ] .

# === 2. LocalConceptShape (ConceptRegistry v0.1.2 §2.2) ===

rkaf:LocalConceptShape
  a sh:NodeShape ;
  sh:targetClass rkaf:LocalConcept ;
  rdfs:label "Local Concept" ;

  sh:property [
    sh:path skos:prefLabel ;
    sh:minCount 1 ;
    sh:message "LocalConcept must have skos:prefLabel." ;
  ] ;

  sh:property [
    sh:path rkaf:definedInScope ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "LocalConcept must declare definedInScope (the organization or workspace that minted it)." ;
  ] ;

  sh:property [
    sh:path rkaf:conceptScope ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( rkaf:organization rkaf:workspace rkaf:personal rkaf:team ) ;
    sh:message "LocalConcept scope must be organization/workspace/personal/team (NOT public)." ;
  ] ;

  sh:property [
    sh:path rkaf:conceptStatus ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:proposed rkaf:localActive rkaf:deprecated rkaf:withdrawn
    ) ;
  ] .

# === 3. ConceptRegistryShape (ConceptRegistry v0.1.2 §3.1) ===

rkaf:ConceptRegistryShape
  a sh:NodeShape ;
  sh:targetClass rkaf:ConceptRegistry ;
  rdfs:label "Concept Registry" ;

  sh:property [
    sh:path rkaf:namespacePrefix ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;

  sh:property [
    sh:path rkaf:mintingAuthority ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:governanceModel ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:singleOrgGovernance
      rkaf:federatedCuration
      rkaf:openCommunity
      rkaf:statutoryRegistry
      rkaf:externalSkosVocabulary
    ) ;
  ] ;

  sh:property [
    sh:path rkaf:resolutionEndpoint ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:registryVersion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] .

# === 4. ConceptMintingAuthorityShape (ConceptRegistry v0.1.2 §3.2) ===

rkaf:ConceptMintingAuthorityShape
  a sh:NodeShape ;
  sh:targetClass rkaf:ConceptMintingAuthority ;
  rdfs:label "Concept Minting Authority" ;

  sh:property [
    sh:path rkaf:authorityKind ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:curationBoard rkaf:agencyAuthority rkaf:statutoryBody
      rkaf:singleOrgAuthority rkaf:communityProcess
    ) ;
  ] ;

  sh:property [
    sh:path rkaf:authorizedActions ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
  ] .

# === 5. MappingAssertionShape (ConceptRegistry v0.1.2 §4) ===
# A mapping assertion is a RelationshipAssertion whose predicate is a SKOS
# mapping property. We use sh:if on the predicate value to conditionally
# require MappingApplicabilityContext at operational eligibility.

rkaf:MappingAssertionShape
  a sh:NodeShape ;
  sh:targetClass rkaf:RelationshipAssertion ;
  rdfs:label "Mapping Assertion (SKOS-predicate-conditional)" ;
  rdfs:comment "Rewritten in Batch 4 using Pattern C for reliable pyshacl evaluation." ;

  # If predicate=skos:closeMatch AND eligibility is operational+, then must
  # declare MappingApplicabilityContext via hasApplicability.
  sh:or (
    # Branch 1: NOT a closeMatch mapping
    [ sh:not [
        sh:property [ sh:path rkaf:assertsPredicate ; sh:hasValue skos:closeMatch ]
    ] ]
    # Branch 2: NOT operational-or-higher eligibility
    [ sh:not [
        sh:property [
          sh:path rkaf:usageEligibility ;
          sh:in ( rkaf:localOperationalUse rkaf:publicationAllowed rkaf:officialUse )
        ]
    ] ]
    # Branch 3: has MappingApplicabilityContext applicability
    [ sh:property [
        sh:path rkaf:hasApplicability ;
        sh:qualifiedValueShape [
          sh:class rkaf:MappingApplicabilityContext ;
        ] ;
        sh:qualifiedMinCount 1 ;
    ] ]
  ) ;
  sh:message "skos:closeMatch mapping at localOperationalUse or higher MUST declare MappingApplicabilityContext via hasApplicability. See ConceptRegistry v0.1.2 §4.4." .

# === 6. MappingApplicabilityContextShape (ConceptRegistry v0.1.2 §4.4) ===

rkaf:MappingApplicabilityContextShape
  a sh:NodeShape ;
  sh:targetClass rkaf:MappingApplicabilityContext ;
  rdfs:label "Mapping Applicability Context" ;

  sh:property [
    sh:path rkaf:applicationDomain ;
    sh:minCount 1 ;
    sh:message "MappingApplicabilityContext must declare applicationDomain (program, workflow, benefit category, process area, or service line)." ;
  ] ;

  sh:property [
    sh:path rkaf:evidencePurpose ;
    sh:minCount 1 ;
    sh:message "MappingApplicabilityContext must declare evidencePurpose (at least one purpose the mapping covers)." ;
  ] .

# === 7. ConceptResolutionResultShape (ConceptRegistry v0.1.2 §5.4) ===

rkaf:ConceptResolutionResultShape
  a sh:NodeShape ;
  sh:targetClass rkaf:ConceptResolutionResult ;
  rdfs:label "Concept Resolution Result" ;

  sh:property [
    sh:path rkaf:inputConcept ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:resolutionStatus ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:resolvedDirect
      rkaf:resolvedViaMapping
      rkaf:unresolvedForOperationalUse
      rkaf:unresolvedNoMapping
      rkaf:unresolvedRegistryUnavailable
      rkaf:unresolvedConceptDeprecated
      rkaf:unresolvedConceptSplit
      rkaf:unresolvedConceptWithdrawn
    ) ;
  ] ;

  sh:property [
    sh:path rkaf:usageCeiling ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:notEligible
      rkaf:searchOnly
      rkaf:reviewQueueOnly
      rkaf:draftGenerationAllowed
      rkaf:localOperationalUse
      rkaf:publicationAllowed
      rkaf:officialUse
    ) ;
    sh:message "ConceptResolutionResult must declare usageCeiling so consumers know the maximum eligibility this concept can support." ;
  ] .

# === 8. SuggestedRemediationShape (ConceptRegistry v0.1.2 §5.9) ===

rkaf:SuggestedRemediationShape
  a sh:NodeShape ;
  sh:targetClass rkaf:SuggestedRemediation ;
  rdfs:label "Suggested Remediation" ;

  sh:property [
    sh:path rkaf:remediationAction ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:createMapping
      rkaf:adoptMapping
      rkaf:narrowApplicability
      rkaf:obtainAttestation
      rkaf:obtainLocalAdoption
      rkaf:awaitConceptRegistration
      rkaf:disambiguateSplitConcept
      rkaf:replaceSupersededReference
      rkaf:requestCanonicalMapping
      rkaf:refreshRegistryCache
    ) ;
    sh:message "SuggestedRemediation must declare a remediationAction from the enumerated vocabulary." ;
  ] .

# === 9. ConceptLifecyclePacketShape (ConceptRegistry v0.1.2 §7.5) ===

rkaf:ConceptLifecyclePacketShape
  a sh:NodeShape ;
  sh:targetClass rkaf:ConceptLifecyclePacket ;
  rdfs:label "Concept Lifecycle Packet" ;

  sh:property [
    sh:path rkaf:lifecycleEvent ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:deprecation rkaf:withdrawal rkaf:merge rkaf:split rkaf:replacedBy
    ) ;
  ] ;

  sh:property [
    sh:path rkaf:subjectConcept ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:effectiveDate ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;

  sh:property [
    sh:path rkaf:bridgeContractVersion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^rkaf-bridge/[0-9]+\\.[0-9]+$" ;
  ] ;

  sh:property [
    sh:path rkaf:cascadeAlgorithm ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "ConceptLifecyclePacket must declare cascadeAlgorithm (e.g., rkaf:CascadeClosureV1)." ;
  ] ;

  # For split/merge/replacedBy events, successorConcepts must be present.
  # Rewritten in Batch 4 using Pattern C for reliable pyshacl evaluation.
  sh:or (
    # Branch 1: lifecycleEvent is NOT split/merge/replacedBy
    [ sh:not [
        sh:property [
          sh:path rkaf:lifecycleEvent ;
          sh:in ( rkaf:split rkaf:merge rkaf:replacedBy )
        ]
    ] ]
    # Branch 2: has successorConcepts
    [ sh:property [
        sh:path rkaf:successorConcepts ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ]
  ) ;
  sh:message "split, merge, and replacedBy lifecycle events MUST declare successorConcepts." .

# === 10. MappingConflictShape (ConceptRegistry v0.1.2 §8) ===

rkaf:MappingConflictShape
  a sh:NodeShape ;
  sh:targetClass rkaf:MappingConflict ;
  rdfs:label "Mapping Conflict" ;

  sh:property [
    sh:path rkaf:conflictingMappings ;
    sh:minCount 2 ;
    sh:nodeKind sh:IRI ;
    sh:message "MappingConflict must reference at least 2 conflicting mappings." ;
  ] ;

  sh:property [
    sh:path rkaf:severity ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:informational
      rkaf:operationalConflict
      rkaf:publicationBlocking
      rkaf:authorityCritical
    ) ;
  ] ;

  # Operational and publication-blocking severities MUST reference an artifact.
  # Rewritten in Batch 4 using Pattern C for reliable pyshacl evaluation.
  sh:or (
    # Branch 1: severity is NOT operationalConflict/publicationBlocking
    [ sh:not [
        sh:property [
          sh:path rkaf:severity ;
          sh:in ( rkaf:operationalConflict rkaf:publicationBlocking )
        ]
    ] ]
    # Branch 2: has sharedArtifact
    [ sh:property [ sh:path rkaf:sharedArtifact ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    # Branch 3: has relatedPublishedArtifact
    [ sh:property [ sh:path rkaf:relatedPublishedArtifact ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
  ) ;
  sh:message "operationalConflict and publicationBlocking severity MUST reference the affected artifact via sharedArtifact or relatedPublishedArtifact." .

# === 11. BridgeConsumerRegistrationShape (Rulespec Core §5.1) ===

rkaf:BridgeConsumerRegistrationShape
  a sh:NodeShape ;
  sh:targetClass rkaf:BridgeConsumerRegistration ;
  rdfs:label "Bridge Consumer Registration" ;

  sh:property [
    sh:path rkaf:consumer ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path rkaf:bridgeContractVersion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^rkaf-bridge/[0-9]+\\.[0-9]+$" ;
  ] ;

  sh:property [
    sh:path rkaf:supportedEvaluationAnchors ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "BridgeConsumerRegistration must declare at least one supportedEvaluationAnchor." ;
  ] .
