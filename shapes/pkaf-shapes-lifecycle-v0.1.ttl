# PKAF Shapes Batch 3 — Lifecycle Packets and Revalidation
# Status: draft, additive to pkaf-shapes-core-v0.1.ttl + pkaf-shapes-conceptregistry-v0.1.ttl
# Profile: PKAF-SHACL-AF
# Bridge contract: pkaf-bridge/1.0
# Spec anchors: PKAF Core v0.1 §4
#
# IMPORTANT: These shapes validate packet STRUCTURE. They do NOT validate
# cascade CORRECTNESS. Whether the affectedAssertions / affectedWorkProducts /
# affectedAdoptions lists were computed correctly by CascadeClosureV1 is a
# runtime conformance test, not a SHACL constraint.

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix pkaf:  <https://w3id.org/pkaf/ns/v1#> .

# === 1. AmendmentPacketShape (PKAF Core §4.4) ===

pkaf:AmendmentPacketShape
  a sh:NodeShape ;
  sh:targetClass pkaf:AmendmentPacket ;
  rdfs:label "Amendment Packet" ;

  sh:property [
    sh:path pkaf:emittedBy ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "AmendmentPacket must reference the emittedBy amends-assertion." ;
  ] ;

  sh:property [
    sh:path pkaf:effectiveDate ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;

  sh:property [
    sh:path pkaf:bridgeContractVersion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^pkaf-bridge/[0-9]+\\.[0-9]+$" ;
  ] ;

  sh:property [
    sh:path pkaf:cascadeAlgorithm ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "AmendmentPacket must declare cascadeAlgorithm (e.g., pkaf:CascadeClosureV1). Structural requirement only; SHACL does not verify cascade output correctness." ;
  ] .

