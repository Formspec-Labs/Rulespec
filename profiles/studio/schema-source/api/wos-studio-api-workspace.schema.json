{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://work-spec.org/schemas/studio-api-workspace/1.0",
  "title": "WOS Studio (Authoring) - API Workspace Bootstrap",
  "description": "Wire shapes for the workspace bootstrap surface per studio/specs/api-workspace.md. The bootstrap response initializes the frontend-MVP shell with workspace metadata, capability and feature-flag state, prompt/model option metadata, reviewer-role summary, source/job/candidate/review links, and explicit non-secret constraints. It is metadata-only and must not include secrets, signed URLs, raw source bytes, prompt bodies, candidate bodies, or review bodies.",
  "$comment": "Promotion status (frontend-MVP bootstrap, 2026-05-08): draft contract; shape is additive-only within schemaVersion 1.0 per ADR-0091.",
  "type": "object",
  "$defs": {
    "WorkspaceBootstrapResponse": {
      "type": "object",
      "description": "Response body for GET /workspace/bootstrap?workspaceId=... .",
      "required": [
        "schemaVersion",
        "generatedAt",
        "actor",
        "workspace",
        "capabilities",
        "featureFlags",
        "promptOptions",
        "modelOptions",
        "reviewerRoleSummary",
        "links",
        "security"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "generatedAt": {
          "$ref": "https://work-spec.org/schemas/studio-api-common/1.0#/$defs/RFC3339Timestamp"
        },
        "actor": {
          "$ref": "#/$defs/BootstrapActor"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceMetadata"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "featureFlags": {
          "$ref": "#/$defs/FeatureFlags"
        },
        "promptOptions": {
          "type": "array",
          "description": "PromptRegistry metadata only. Rendered prompt bodies and hidden/system prompt content are forbidden by SA-MUST-api-workspace-050.",
          "items": {
            "$ref": "#/$defs/PromptOption"
          }
        },
        "modelOptions": {
          "type": "array",
          "description": "ModelAdapter metadata only. Provider credentials and deployment topology are forbidden by SA-MUST-api-workspace-050/053.",
          "items": {
            "$ref": "#/$defs/ModelOption"
          }
        },
        "reviewerRoleSummary": {
          "$ref": "#/$defs/ReviewerRoleSummary"
        },
        "links": {
          "$ref": "#/$defs/SurfaceLinks"
        },
        "security": {
          "$ref": "#/$defs/BootstrapSecurity"
        }
      }
    },
    "BootstrapActor": {
      "type": "object",
      "required": [
        "subjectId",
        "roleIds"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "subjectId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "roleIds": {
          "type": "array",
          "description": "ReviewerRole ids the actor may currently use in this workspace.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "WorkspaceMetadata": {
      "type": "object",
      "description": "Compact Workspace metadata for frontend shell initialization. The canonical Workspace object remains studio/schemas/wos-studio-workspace.schema.json.",
      "required": [
        "id",
        "title",
        "lifecycleState",
        "programs",
        "policySummary"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "lifecycleState": {
          "type": "string",
          "enum": [
            "active",
            "suspended",
            "archived"
          ]
        },
        "programs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerRefs": {
          "type": "array",
          "description": "Workspace owner subject refs visible to the actor.",
          "items": {
            "type": "string"
          }
        },
        "permissionsRef": {
          "type": "string"
        },
        "policySummary": {
          "$ref": "#/$defs/WorkspacePolicySummary"
        }
      }
    },
    "WorkspacePolicySummary": {
      "type": "object",
      "description": "Non-secret, compact policy disclosure for shell initialization. Full SourceUsePolicy / ModelUsePolicy rule bodies are intentionally omitted.",
      "required": [
        "selfApprovalProhibitionMode",
        "requiredPublicationRoleIds",
        "sourceUsePolicy",
        "modelUsePolicy"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "selfApprovalProhibitionMode": {
          "type": "string",
          "enum": [
            "strict",
            "trivial-exempt",
            "disabled"
          ]
        },
        "requiredPublicationRoleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unmappedButApprovedAuthority": {
          "type": "string"
        },
        "conflictWaiverAuthority": {
          "type": "string"
        },
        "sourceUsePolicy": {
          "$ref": "#/$defs/PolicyDisclosure"
        },
        "modelUsePolicy": {
          "$ref": "#/$defs/PolicyDisclosure"
        }
      }
    },
    "PolicyDisclosure": {
      "type": "object",
      "required": [
        "enforced"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "enforced": {
          "type": "boolean"
        },
        "policyRef": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        },
        "policyDigest": {
          "type": "string",
          "description": "Optional content digest of the typed policy document. The rule body itself is not included.",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "statusLabel": {
          "type": "string"
        }
      }
    },
    "Capability": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable capability id. Clients must tolerate unknown ids."
        },
        "status": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled",
            "unavailable",
            "degraded"
          ]
        },
        "label": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "since": {
          "$ref": "https://work-spec.org/schemas/studio-api-common/1.0#/$defs/RFC3339Timestamp"
        }
      }
    },
    "FeatureFlags": {
      "type": "object",
      "description": "Stable frontend-MVP booleans derived from capabilities. x-* keys are extension points.",
      "required": [
        "sourceIngestion",
        "directBlobUpload",
        "sourceRawRead",
        "sourceSections",
        "asyncJobs",
        "aiExtraction",
        "candidateReview",
        "reviewQueue",
        "projectionPreview",
        "workspacePolicyEdit",
        "runtimeObservation",
        "exportBundle"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "sourceIngestion": {
          "type": "boolean"
        },
        "directBlobUpload": {
          "type": "boolean"
        },
        "sourceRawRead": {
          "type": "boolean"
        },
        "sourceSections": {
          "type": "boolean"
        },
        "asyncJobs": {
          "type": "boolean"
        },
        "aiExtraction": {
          "type": "boolean"
        },
        "candidateReview": {
          "type": "boolean"
        },
        "reviewQueue": {
          "type": "boolean"
        },
        "projectionPreview": {
          "type": "boolean"
        },
        "workspacePolicyEdit": {
          "type": "boolean"
        },
        "runtimeObservation": {
          "type": "boolean"
        },
        "exportBundle": {
          "type": "boolean"
        }
      }
    },
    "PromptOption": {
      "type": "object",
      "description": "Non-secret PromptRegistry option metadata. Prompt body fields are intentionally absent.",
      "required": [
        "promptTemplateRef",
        "promptTemplateVersion",
        "displayName",
        "purpose"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "promptTemplateRef": {
          "type": "string"
        },
        "promptTemplateVersion": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "extract",
            "verify",
            "summarize",
            "map",
            "review"
          ]
        },
        "default": {
          "type": "boolean"
        },
        "supportedCandidateKinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "templateBody"
            ]
          },
          {
            "required": [
              "promptBody"
            ]
          },
          {
            "required": [
              "systemPrompt"
            ]
          }
        ]
      }
    },
    "ModelOption": {
      "type": "object",
      "description": "Non-secret ModelAdapter option metadata. Credentials and provider secrets are intentionally absent.",
      "required": [
        "modelId",
        "modelFamily",
        "modelVersionPolicy",
        "role",
        "enabled"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "modelId": {
          "type": "string"
        },
        "modelFamily": {
          "type": "string",
          "description": "Non-secret model-family label used to explain extractor/verifier independence."
        },
        "modelVersionPolicy": {
          "type": "string",
          "enum": [
            "pinned",
            "rolling",
            "latest"
          ]
        },
        "resolvedModelVersion": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "extractor",
            "verifier",
            "embedding"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "nonSecretLabel": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "apiKey"
            ]
          },
          {
            "required": [
              "credential"
            ]
          },
          {
            "required": [
              "credentials"
            ]
          },
          {
            "required": [
              "secret"
            ]
          },
          {
            "required": [
              "token"
            ]
          }
        ]
      }
    },
    "ReviewerRoleSummary": {
      "type": "object",
      "required": [
        "currentActorRoleIds",
        "requiredForPublicationRoleIds",
        "roles"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "currentActorRoleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredForPublicationRoleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewerRoleView"
          }
        }
      }
    },
    "ReviewerRoleView": {
      "type": "object",
      "required": [
        "id",
        "name",
        "hasOverrideAuthority",
        "requiredForPublication"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hasOverrideAuthority": {
          "type": "boolean"
        },
        "requiredForPublication": {
          "type": "boolean"
        },
        "activeDecisionCount": {
          "type": "integer",
          "minimum": 0
        },
        "missingForPublication": {
          "type": "boolean"
        }
      }
    },
    "SurfaceLinks": {
      "type": "object",
      "description": "Stable link keys for workspace shell navigation. Availability may be false while target endpoint bodies are specified separately.",
      "required": [
        "workspace",
        "sources",
        "sourceUploadTargets",
        "jobs",
        "candidates",
        "candidateReviewActions"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "workspace": {
          "$ref": "#/$defs/SurfaceLink"
        },
        "sources": {
          "$ref": "#/$defs/SurfaceLink"
        },
        "sourceUploadTargets": {
          "$ref": "#/$defs/SurfaceLink"
        },
        "jobs": {
          "$ref": "#/$defs/SurfaceLink"
        },
        "candidates": {
          "$ref": "#/$defs/SurfaceLink"
        },
        "candidateReviewActions": {
          "$ref": "#/$defs/SurfaceLink"
        },
        "reviewQueue": {
          "$ref": "#/$defs/SurfaceLink"
        },
        "projectionPreview": {
          "$ref": "#/$defs/SurfaceLink"
        },
        "exportBundle": {
          "$ref": "#/$defs/SurfaceLink"
        }
      }
    },
    "SurfaceLink": {
      "type": "object",
      "required": [
        "rel",
        "method",
        "href"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "rel": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "href": {
          "type": "string",
          "description": "Non-secret URI or URI template. Signed upload URLs must not appear here."
        },
        "templated": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean",
          "default": true
        },
        "schemaRef": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "BootstrapSecurity": {
      "type": "object",
      "description": "Explicit non-secret/caching declaration for frontend handling.",
      "required": [
        "secretsRedacted",
        "containsSignedUrls",
        "containsRawSourceBytes",
        "cacheScope",
        "maxCacheTtlSeconds",
        "nonSecretConstraints"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "secretsRedacted": {
          "type": "boolean",
          "const": true
        },
        "containsSignedUrls": {
          "type": "boolean",
          "const": false
        },
        "containsRawSourceBytes": {
          "type": "boolean",
          "const": false
        },
        "cacheScope": {
          "type": "string",
          "enum": [
            "no-store",
            "private-actor",
            "private-actor-workspace"
          ]
        },
        "maxCacheTtlSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "nonSecretConstraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "metadata-only",
              "no-prompt-bodies",
              "no-provider-credentials",
              "no-signed-upload-urls",
              "no-source-bytes",
              "no-source-excerpts",
              "no-candidate-bodies",
              "no-review-bodies",
              "no-private-signing-keys",
              "no-bearer-tokens"
            ]
          }
        }
      }
    }
  }
}
