{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://work-spec.org/schemas/studio-api-review/1.0",
  "title": "WOS Studio (Authoring) - API Extracted Candidate Review Actions",
  "description": "Wire shapes for the minimal extracted-candidate review-action surface per studio/specs/api-review.md. This schema covers the frontend-MVP approve/reject/request-revision action request, the synchronous response, review intent projection, and explicit promotion-block state. It intentionally excludes ApprovalPackage assembly, signing, publication, and export.",
  "$comment": "Promotion status (Phase 5 frontend-MVP, 2026-05-08): minimal review action and promotion-block contract only.",
  "type": "object",
  "$defs": {
    "ReviewAction": {
      "type": "string",
      "description": "Reviewer action over an extracted candidate per SA-MUST-api-review-020.",
      "enum": [
        "approve",
        "reject",
        "request-revision"
      ]
    },
    "PromotionIntent": {
      "type": "string",
      "description": "Client intent for what should happen after approval. The endpoint records review intent either way; package assembly/signing remains out of scope.",
      "enum": [
        "record-only",
        "promote-if-unblocked"
      ]
    },
    "RequestedRevision": {
      "type": "object",
      "description": "Structured revision request required when action=request-revision.",
      "required": [
        "requestedChanges"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "requestedChanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dueAt": {
          "$ref": "https://work-spec.org/schemas/studio-api-common/1.0#/$defs/RFC3339Timestamp"
        },
        "assigneeRef": {
          "type": "string"
        }
      }
    },
    "CandidateReviewActionRequest": {
      "type": "object",
      "description": "POST /extracted-candidates/{id}/review-actions request body. The path supplies candidateId; body supplies workspace scope and reviewer intent.",
      "required": [
        "workspaceId",
        "action",
        "reviewerRole",
        "expectedCandidateVersion",
        "expectedReviewSnapshotVersion",
        "observedFindingRefs",
        "rationale"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "workspaceId": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ReviewAction"
        },
        "reviewerRole": {
          "type": "string",
          "description": "Workspace ReviewerRole selected for this decision. Must resolve to an active role authorized for extracted-object review."
        },
        "expectedCandidateVersion": {
          "type": "string",
          "description": "Opaque version token from the candidate read model. Stale tokens return 412 per SA-MUST-api-review-051."
        },
        "expectedReviewSnapshotVersion": {
          "type": "string",
          "description": "Opaque version token for the server review snapshot covering visible findings, source supersession state, and visible promotion-block inputs. Stale tokens return 412 per SA-MUST-api-review-027."
        },
        "observedFindingRefs": {
          "type": "array",
          "description": "ValidationFinding ids visible to the reviewer at decision time. Empty only when the server snapshot has no candidate findings.",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "promotionIntent": {
          "$ref": "#/$defs/PromotionIntent"
        },
        "requestedRevision": {
          "$ref": "#/$defs/RequestedRevision"
        },
        "clientRequestRef": {
          "type": "string",
          "description": "Optional caller-side correlation handle. Idempotency is still controlled by the Idempotency-Key header."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "request-revision"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "requestedRevision"
            ],
            "$comment": "Per SA-MUST-api-review-023: request-revision requires non-empty requestedRevision.requestedChanges[]."
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "approve",
                  "reject"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "not": {
              "required": [
                "requestedRevision"
              ]
            },
            "$comment": "Per SA-MUST-api-review-026: approve/reject requests must not carry revision details."
          }
        }
      ]
    },
    "PromotionBlockReason": {
      "type": "object",
      "description": "One reason a candidate cannot be promoted past extracted state.",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "automation-eligibility-not-can-drive-automation",
            "missing-human-approval",
            "unauthorized-reviewer-role",
            "self-approval-prohibited",
            "open-critical-finding",
            "candidate-version-conflict",
            "source-superseded",
            "validation-failed",
            "revision-requested",
            "rejected",
            "not-approved-action"
          ]
        },
        "ruleId": {
          "type": "string",
          "description": "Normative rule or lint id causing the block, when applicable."
        },
        "message": {
          "type": "string"
        },
        "subjectRef": {
          "type": "string",
          "description": "Candidate, source, finding, or role reference responsible for the block."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "block"
          ]
        }
      }
    },
    "PromotionBlockState": {
      "type": "object",
      "description": "Explicit promotion-block result returned by every review action per SA-MUST-api-review-040.",
      "required": [
        "state",
        "reasons"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not-requested",
            "unblocked",
            "blocked",
            "not-applicable"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PromotionBlockReason"
          }
        },
        "evaluatedAt": {
          "$ref": "https://work-spec.org/schemas/studio-api-common/1.0#/$defs/RFC3339Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "blocked"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            },
            "$comment": "Per SA-MUST-api-review-040: blocked promotion state requires at least one reason."
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unblocked"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reasons": {
                "maxItems": 0
              }
            },
            "$comment": "Per SA-MUST-api-review-040: unblocked promotion state carries no reasons."
          }
        }
      ]
    },
    "ReviewIntent": {
      "type": "object",
      "description": "Durable projection of the reviewer intent recorded by the endpoint. This may reference an ApprovalDecision, but not an ApprovalPackage.",
      "required": [
        "actionId",
        "candidateId",
        "action",
        "reviewerRole",
        "reviewedBy",
        "reviewedAt",
        "rationale",
        "reviewSnapshotVersion",
        "observedFindingRefs"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "actionId": {
          "type": "string"
        },
        "candidateId": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ReviewAction"
        },
        "reviewerRole": {
          "type": "string"
        },
        "reviewedBy": {
          "type": "string",
          "description": "IdentitySubject resolved from the session bearer."
        },
        "reviewedAt": {
          "$ref": "https://work-spec.org/schemas/studio-api-common/1.0#/$defs/RFC3339Timestamp"
        },
        "rationale": {
          "type": "string"
        },
        "reviewSnapshotVersion": {
          "type": "string",
          "description": "Accepted review snapshot version recorded with the durable review intent."
        },
        "observedFindingRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requestedRevision": {
          "$ref": "#/$defs/RequestedRevision"
        },
        "approvalDecisionRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional ApprovalDecision id for extracted-object review. ApprovalPackage assembly remains out of scope."
        }
      }
    },
    "CandidateReviewProjection": {
      "type": "object",
      "description": "Compact candidate projection returned with review-action responses so clients can update UI state without another read.",
      "required": [
        "candidateId",
        "candidateVersion",
        "reviewState",
        "sourceRefs",
        "confidence",
        "aiLineage",
        "verifierResult"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "candidateId": {
          "type": "string"
        },
        "candidateVersion": {
          "type": "string"
        },
        "reviewState": {
          "$ref": "https://work-spec.org/schemas/studio-common/1.0#/$defs/ExtractedClaimReviewState"
        },
        "candidateType": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "description": "SourceVersion, SourceSection, or SourceCitation refs that support the candidate.",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "$ref": "https://work-spec.org/schemas/studio-api-candidates/1.0#/$defs/ConfidenceRecord"
        },
        "aiLineage": {
          "type": "object",
          "description": "Summary of extraction lineage. Full provenance remains in the AuthoringLedger.",
          "required": [
            "modelId",
            "modelVersion",
            "modelFamily",
            "promptTemplateRef",
            "promptTemplateVersion",
            "inputContextHash"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^(\\$|x-)": {}
          },
          "properties": {
            "modelId": {
              "type": "string"
            },
            "modelVersion": {
              "type": "string"
            },
            "modelFamily": {
              "type": "string",
              "description": "Extractor model family preserved for verifier-independence audit."
            },
            "promptTemplateRef": {
              "type": "string"
            },
            "promptTemplateVersion": {
              "type": "string"
            },
            "inputContextHash": {
              "$ref": "https://work-spec.org/schemas/studio-api-candidates/1.0#/$defs/Sha256Hash"
            }
          }
        },
        "verifierResult": {
          "$ref": "https://work-spec.org/schemas/studio-api-candidates/1.0#/$defs/VerifierResult"
        },
        "promotedPolicyObjectRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CandidateReviewActionResponse": {
      "type": "object",
      "description": "Synchronous response for POST /extracted-candidates/{id}/review-actions.",
      "required": [
        "workspaceId",
        "candidateId",
        "actionId",
        "action",
        "reviewState",
        "reviewerRole",
        "reviewedBy",
        "reviewedAt",
        "candidateVersion",
        "expectedReviewSnapshotVersion",
        "observedFindingRefs",
        "promotionBlock",
        "provenanceRecordIds",
        "candidate"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(\\$|x-)": {}
      },
      "properties": {
        "workspaceId": {
          "type": "string"
        },
        "candidateId": {
          "type": "string"
        },
        "actionId": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ReviewAction"
        },
        "reviewState": {
          "$ref": "https://work-spec.org/schemas/studio-common/1.0#/$defs/ExtractedClaimReviewState"
        },
        "reviewerRole": {
          "type": "string"
        },
        "reviewedBy": {
          "type": "string"
        },
        "reviewedAt": {
          "$ref": "https://work-spec.org/schemas/studio-api-common/1.0#/$defs/RFC3339Timestamp"
        },
        "candidateVersion": {
          "type": "string"
        },
        "expectedReviewSnapshotVersion": {
          "type": "string",
          "description": "Echo of the accepted request precondition binding this decision to a review snapshot."
        },
        "observedFindingRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "promotionBlock": {
          "$ref": "#/$defs/PromotionBlockState"
        },
        "provenanceRecordIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewIntent": {
          "$ref": "#/$defs/ReviewIntent"
        },
        "candidate": {
          "$ref": "#/$defs/CandidateReviewProjection"
        },
        "approvalDecisionRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "promotedPolicyObjectRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional result of separate normalizer/promotion work. This endpoint does not require it."
        }
      }
    }
  }
}
