{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulespec.org/schemas/releases/extrapolation-release-v2/assignments-v1.schema.json",
  "title": "ExtrapolationRelease v2 assignment row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "document_version_id",
    "assignment_id",
    "subject_ref",
    "subject_kind",
    "predicate",
    "concept_id",
    "polarity",
    "assigned_concept_release_id",
    "origin",
    "usage_eligibility",
    "evidence_binding_refs",
    "extraction_activity_id",
    "ai_lineage_id",
    "selection_result",
    "confidence"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "document_version_id": {
      "type": "string",
      "minLength": 1
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^urn:rulespec:concept-assignment:[0-9a-f]{64}$"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "subject_kind": {
      "enum": [
        "Artifact",
        "SourceFragment"
      ]
    },
    "predicate": {
      "enum": [
        "assignmentPrimary",
        "assignmentSubstantive",
        "assignmentMention",
        "assignmentContextual"
      ]
    },
    "concept_id": {
      "type": "string",
      "minLength": 1
    },
    "polarity": {
      "const": "affirmed"
    },
    "assigned_concept_release_id": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "aiSuggested",
        "deterministicExtraction"
      ]
    },
    "usage_eligibility": {
      "const": "searchOnly"
    },
    "evidence_binding_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extraction_activity_id": {
      "type": "string",
      "minLength": 1
    },
    "ai_lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "selection_result": {
      "enum": [
        "selected",
        "not_selected",
        "deferred"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ]
    }
  }
}
