# === 5. RevalidationEventShape (Rulespec Core §4.8) ===

rkaf:RevalidationEventShape
  a sh:NodeShape ;
  sh:targetClass rkaf:RevalidationEvent ;
  rdfs:label "Revalidation Event" ;

  sh:property [
    sh:path rkaf:triggeredByPacket ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "RevalidationEvent must reference the triggeredByPacket." ;
  ] ;

  # Must target an assertion, a work product, or both — at least one
  sh:or (
    [ sh:property [ sh:path rkaf:targetAssertion ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    [ sh:property [ sh:path rkaf:targetWorkProduct ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
  ) ;
  sh:message "RevalidationEvent must reference at least one of: targetAssertion or targetWorkProduct." ;

  sh:property [
    sh:path rkaf:transitionTo ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( rkaf:staleForCurrentUse rkaf:needsRevalidation rkaf:blocked rkaf:disputed ) ;
    sh:message "RevalidationEvent must declare transitionTo from the enumerated set." ;
  ] ;

  sh:property [
    sh:path rkaf:queuedFor ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "RevalidationEvent must queue to a reviewer or role (queuedFor)." ;
  ] ;

  sh:property [
    sh:path prov:generatedAtTime ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] .

# === 6. RevalidationClosureEventShape (Rulespec Core §4.8) ===

rkaf:RevalidationClosureEventShape
  a sh:NodeShape ;
  sh:targetClass rkaf:RevalidationClosureEvent ;
  rdfs:label "Revalidation Closure Event" ;

  sh:property [
    sh:path rkaf:closesRevalidationEvent ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "RevalidationClosureEvent must reference the RevalidationEvent being closed." ;
  ] ;

  sh:property [
    sh:path rkaf:closureDecision ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (
      rkaf:revalidatedWithSuccessor
      rkaf:revalidatedWithoutSuccessor
      rkaf:closedAsObsolete
      rkaf:closedAsResolved
    ) ;
  ] ;

  sh:property [
    sh:path rkaf:closedBy ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path prov:generatedAtTime ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;

  # If closure decision is revalidatedWithSuccessor, must reference at least one successor.
  # Rewritten in Batch 4 using Pattern C for reliable pyshacl evaluation.
  sh:or (
    # Branch 1: closureDecision is NOT revalidatedWithSuccessor
    [ sh:not [
        sh:property [
          sh:path rkaf:closureDecision ;
          sh:hasValue rkaf:revalidatedWithSuccessor
        ]
    ] ]
    # Branch 2: has successorAssertion (singular)
    [ sh:property [ sh:path rkaf:successorAssertion ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    # Branch 3: has successorAssertions (plural list for split cases)
    [ sh:property [ sh:path rkaf:successorAssertions ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    # Branch 4: has successorWorkProduct (for work-product-level revalidation)
    [ sh:property [ sh:path rkaf:successorWorkProduct ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
  ) ;
  sh:message "RevalidationClosureEvent with closureDecision=revalidatedWithSuccessor must reference at least one successor via successorAssertion (singular), successorAssertions (plural for split cases), or successorWorkProduct." .

# === 7. PointInTimeExceptionShape (Rulespec Core §4.6, §4.7) ===

rkaf:PointInTimeExceptionShape
  a sh:NodeShape ;
  sh:targetClass rkaf:PointInTimeException ;
  rdfs:label "Point-in-Time Exception" ;

  sh:property [
    sh:path rkaf:evaluationAnchor ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:or (
      [ sh:in (
          rkaf:applicationSubmissionTime
          rkaf:eventOccurrenceTime
          rkaf:eligibilityDeterminationTime
          rkaf:noticeGenerationTime
          rkaf:workflowStartTime
          rkaf:workflowStepStartTime
          rkaf:currentTime
          rkaf:effectivePeriodStart
          rkaf:publicationTime
        ) ]
      [ sh:nodeKind sh:IRI ; sh:pattern "^https?://" ;
        sh:description "Extension URIs MUST be HTTP(S) IRIs declared in a rkaf:EvaluationAnchorExtensionRegistry." ]
    ) ;
    sh:message "PointInTimeException must declare evaluationAnchor from the closed v0.1 enum or a declared extension URI." ;
  ] ;

  # Must retain at least an assertion or work product so consumers know what
  # the exception preserves
  sh:or (
    [ sh:property [ sh:path rkaf:retainsAssertion ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    [ sh:property [ sh:path rkaf:retainsWorkProduct ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
  ) ;
  sh:message "PointInTimeException must reference what it retains via retainsAssertion or retainsWorkProduct." .
