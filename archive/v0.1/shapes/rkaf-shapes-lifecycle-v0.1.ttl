# Rulespec Shapes Batch 3 — Lifecycle Packets and Revalidation
# Status: draft, additive to rkaf-shapes-core-v0.1.ttl + rkaf-shapes-conceptregistry-v0.1.ttl
# Profile: Rulespec-SHACL-AF
# Bridge contract: rkaf-bridge/1.0
# Spec anchors: Rulespec Core v0.1 §4
#
# IMPORTANT: These shapes validate packet STRUCTURE. They do NOT validate
# cascade CORRECTNESS. Whether the affectedAssertions / affectedWorkProducts /
# affectedAdoptions lists were computed correctly by CascadeClosureV1 is a
# runtime conformance test, not a SHACL constraint.

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix rkaf:  <https://rulespec.org/ns/v1#> .

# === 1. AmendmentPacketShape (Rulespec Core §4.4) ===

rkaf:AmendmentPacketShape
  a sh:NodeShape ;
  sh:targetClass rkaf:AmendmentPacket ;
  rdfs:label "Amendment Packet" ;

  sh:property [
    sh:path rkaf:emittedBy ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "AmendmentPacket must reference the emittedBy amends-assertion." ;
  ] ;

  sh:property [
    sh:path rkaf:effectiveDate ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;

  sh:property [
    sh:path rkaf:bridgeContractVersion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:pattern "^rkaf-bridge/[0-9]+\\.[0-9]+$" ;
  ] ;

  sh:property [
    sh:path rkaf:cascadeAlgorithm ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "AmendmentPacket must declare cascadeAlgorithm (e.g., rkaf:CascadeClosureV1). Structural requirement only; SHACL does not verify cascade output correctness." ;
  ] .

