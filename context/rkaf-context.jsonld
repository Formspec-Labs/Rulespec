  "_meta": {
    "version": "v0.2.0-pre.5",
    "supersedes": "v0.1.1",
    "relationship": "Vocabulary v0.2 — first-class Warrant/Artifact/SourceFragment/EvidenceBinding/ConfidenceRecord/AccessScope/AILineage/RetentionPolicy/MappingState/Workspace primitives; OA/PROV-O/SKOS/DCTERMS/CiTO/DCAT imports; ELI/ELI-DL/ELI-I/Akoma-Ntoso/USLM/LegalRuleML/RRMV/ECO/SEPIO/ODRL/DPV/Schema.org alignments. v0.1.x is editorial baseline only — wholesale supersession.",
    "delta_from_v0.1": [
      "Added rkaf:definedInScope as @type:@id (was missing, treated as string literal in v0.1)",
      "Added rkaf:Artifact, rkaf:SourceFragment, rkaf:EvidenceBinding, rkaf:Warrant, rkaf:ConfidenceRecord, rkaf:AccessScope as first-class primitives",
      "Added rkaf:hasWarrant universal grounding predicate (rkaf:hasAuthority becomes legal-family specialization)",
      "Added rkaf:AILineage with mandatory humanApprover",
      "Added rkaf:MappingState, rkaf:RetentionPolicy, rkaf:Workspace, rkaf:projectsTo, rkaf:llmHint (Studio-derived promotions)",
      "Added rkaf:anchoredBy / rkaf:anchorType (abstract anchoring contract, bindings live outside Rulespec)",
      "Imported namespaces: prov, oa, skos, dcterms, cito, dcat, rdf, rdfs, xsd, sh",
      "Aligned namespaces: eli, eli-dl, eli-i, aknt, uslm, lrml, rrmv, eco, sepio, dpv, odrl, nano, schemaorg"
    ],
    "note": "_meta is JSON-LD-safe: keys not in @context are ignored by JSON-LD processors."
  }
}
