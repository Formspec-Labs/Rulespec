  "dcterms:publisher": {
    "@type": "foaf:Organization",
    "foaf:name": "Rulespec maintainers"
  },
  "dcat:keyword": ["model-card", "ai-governance", "evaluation", "reference-corpus"],
  "dcat:theme":   ["ai-governance", "model-metadata"],
  "dcat:distribution": [
    { "@type": "dcat:Distribution", "dcat:downloadURL": "data/", "dcat:mediaType": "application/ld+json" }
  ],
  "rkaf:declaredConformanceLevel": "L3",
  "rkaf:declaredAdoptionDepth":     "D2",
  "rkaf:rulespecVersion":           "0.2.0-pre.6"
}
