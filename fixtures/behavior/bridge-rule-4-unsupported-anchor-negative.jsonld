        "rkaf:supportsRegistryVersionRange": [
          "^1.0"
        ],
        "rkaf:supportedAutomaticMigrations": [],
        "rkaf:supportedAuthorityKinds": [
          "rkaf:statutory"
        ]
      }
    ]
  },
  "rkaf:expectedOutput": {
    "bridgeValidationResult": "rkaf:rejected",
    "errorClass": "rkaf:UnsupportedEvaluationAnchor",
    "rationale": "Anchor rkaf:eligibilityDeterminationTime not in consumer's supportedEvaluationAnchors"
  }
