{
  "@context": "../../context/rkaf-context.jsonld",
  "@id": "urn:rkaf:fixture:beh:cmpb:case1",
  "@type": "rkaf:BehaviorTestCase",
  "rkaf:behaviorContract": "rkaf:ConceptResolutionWithConflict",
  "rkaf:rationale": "Both mappings carry lifecycleState=approved AND target different concepts. \u00a76.1 upgrades severity to publicationBlocking.",
  "rkaf:input": {
    "@graph": [
      {
        "@id": "X",
        "@type": "rkaf:LocalConcept",
        "rkaf:definedInScope": "urn:rkaf:scope:test",
        "rkaf:conceptScope": "urn:rkaf:scope:test",
        "rkaf:conceptStatus": "rkaf:active",
        "skos:prefLabel": "X"
      },
      {
        "@id": "m1",
        "@type": "rkaf:ConceptMapping",
        "rkaf:sourceConcept": "X",
        "rkaf:targetConcept": "canon:A",
        "rkaf:mappingRelation": "skos:exactMatch",
        "rkaf:lifecycleState": "rkaf:approved",
        "rkaf:managedByRegistry": "urn:rkaf:registry:r1"
      },
      {
        "@id": "m2",
        "@type": "rkaf:ConceptMapping",
        "rkaf:sourceConcept": "X",
        "rkaf:targetConcept": "canon:B",
        "rkaf:mappingRelation": "skos:exactMatch",
        "rkaf:lifecycleState": "rkaf:approved",
        "rkaf:managedByRegistry": "urn:rkaf:registry:r2"
      }
    ]
  },
  "rkaf:expectedOutput": {
    "resolutionResult": "rkaf:conflict",
    "registryConflict": {
      "conflictingEntries": [
        "m1",
        "m2"
      ],
      "severity": "rkaf:publicationBlocking"
    }
  }
}
