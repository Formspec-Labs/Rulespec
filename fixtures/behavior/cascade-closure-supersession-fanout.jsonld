{
  "@context": "../../context/rkaf-context.jsonld",
  "@id": "urn:rkaf:fixture:beh:casc-fan:case1",
  "@type": "rkaf:BehaviorTestCase",
  "rkaf:behaviorContract": "rkaf:CascadeClosureV1",
  "rkaf:cascadeSeed": "A",
  "rkaf:rationale": "Assertion A is superseded by B (trigger edge T1; B's supersedesAssertion identifies A as the seed). Two work products W1 + W2 are justifiedByAssertion A (cascade edge C2). Cascade closure from seed A reaches {A, W1, W2}; B is the superseder and per §2.1 is NOT in the affected set.",
  "rkaf:input": {
    "@graph": [
      {
        "@id": "A",
        "@type": "rkaf:Assertion",
        "rkaf:assertionOrigin": "rkaf:humanAsserted"
      },
      {
        "@id": "B",
        "@type": "rkaf:Assertion",
        "rkaf:assertionOrigin": "rkaf:humanAsserted",
        "rkaf:supersedesAssertion": "A"
      },
      {
        "@id": "W1",
        "@type": "rkaf:GeneratedWorkProduct",
        "rkaf:justifiedByAssertion": "A"
      },
      {
        "@id": "W2",
        "@type": "rkaf:GeneratedWorkProduct",
        "rkaf:justifiedByAssertion": "A"
      }
    ]
  },
  "rkaf:expectedOutput": {
    "affectedSet": [
      "A",
      "W1",
      "W2"
    ],
    "algorithm": "rkaf:CascadeClosureV1"
  }
}
