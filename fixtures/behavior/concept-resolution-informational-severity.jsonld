{
  "@context": "../../context/rkaf-context.jsonld",
  "@id": "urn:rkaf:fixture:beh:cm-info:case1",
  "@type": "rkaf:BehaviorTestCase",
  "rkaf:behaviorContract": "rkaf:ConceptResolutionWithConflict",
  "rkaf:rationale": "Two mappings target different concepts but neither uses exactMatch. Severity = informational.",
  "rkaf:input": {
    "@graph": [
      {
        "@id": "urn:rkaf:fixture:concept:X",
        "@type": "rkaf:LocalConcept",
        "rkaf:definedInScope": "urn:rkaf:scope:test",
        "rkaf:conceptScope": "urn:rkaf:scope:test",
        "skos:prefLabel": "X",
        "skos:inScheme": "urn:rkaf:scheme:test-topic"
      },
      {
        "@id": "m1",
        "@type": "rkaf:ConceptMapping",
        "rkaf:assertionOrigin": "rkaf:humanAsserted",
        "rkaf:epistemicBasis": "rkaf:editorialAssertion",
        "rkaf:assertsSubject": "urn:rkaf:fixture:concept:X",
        "rkaf:assertsPredicate": "skos:closeMatch",
        "rkaf:assertsObject": "canon:A",
        "rkaf:assertionPolarity": "rkaf:affirmed",
        "rkaf:sourceConceptRelease": "urn:rkaf:fixture:release:test-source",
        "rkaf:targetConceptRelease": "urn:rkaf:fixture:release:test-target"
      },
      {
        "@id": "m2",
        "@type": "rkaf:ConceptMapping",
        "rkaf:assertionOrigin": "rkaf:humanAsserted",
        "rkaf:epistemicBasis": "rkaf:editorialAssertion",
        "rkaf:assertsSubject": "urn:rkaf:fixture:concept:X",
        "rkaf:assertsPredicate": "skos:closeMatch",
        "rkaf:assertsObject": "canon:B",
        "rkaf:assertionPolarity": "rkaf:affirmed",
        "rkaf:sourceConceptRelease": "urn:rkaf:fixture:release:test-source",
        "rkaf:targetConceptRelease": "urn:rkaf:fixture:release:test-target"
      }
    ]
  },
  "rkaf:expectedOutput": {
    "resolutionResult": "rkaf:conflict",
    "registryConflict": {
      "conflictingEntries": [
        "m1",
        "m2"
      ],
      "severity": "rkaf:informational"
    }
  }
}
